  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^20",
    "@types/pg": "8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
