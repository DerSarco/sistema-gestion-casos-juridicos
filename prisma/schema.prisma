generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum CaseStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum CatalogType {
  MATTER
  STAGE
  PRIORITY
  MILESTONE_TYPE
}

model Study {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  users         User[]
  roles         Role[]
  clients       Client[]
  cases         LegalCase[]
  catalogValues CatalogValue[]
  auditEvents   AuditEvent[]

  @@map("studies")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  studyId     String   @map("study_id") @db.Uuid
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  study       Study    @relation(fields: [studyId], references: [id], onDelete: Restrict)
  users       User[]

  @@unique([studyId, name])
  @@index([studyId, active])
  @@map("roles")
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  studyId          String       @map("study_id") @db.Uuid
  roleId           String       @map("role_id") @db.Uuid
  displayName      String       @map("display_name")
  accessIdentifier String       @map("access_identifier")
  status           UserStatus   @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  study            Study        @relation(fields: [studyId], references: [id], onDelete: Restrict)
  role             Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignments      Assignment[] @relation("AssignmentResponsible")
  assignedBy       Assignment[] @relation("AssignmentActor")
  auditEvents      AuditEvent[]

  @@unique([studyId, accessIdentifier])
  @@index([studyId, status])
  @@map("users")
}

model Client {
  id          String       @id @default(uuid()) @db.Uuid
  studyId     String       @map("study_id") @db.Uuid
  displayName String       @map("display_name")
  email       String?
  phone       String?
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  study       Study        @relation(fields: [studyId], references: [id], onDelete: Restrict)
  cases       LegalCase[]

  @@index([studyId, displayName])
  @@index([studyId, email])
  @@map("clients")
}

model CatalogValue {
  id          String      @id @default(uuid()) @db.Uuid
  studyId     String      @map("study_id") @db.Uuid
  type        CatalogType
  code        String
  name        String
  description String?
  sortOrder   Int         @default(0) @map("sort_order")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  study       Study       @relation(fields: [studyId], references: [id], onDelete: Restrict)
  matterCases LegalCase[] @relation("CaseMatter")
  stageCases  LegalCase[] @relation("CaseStage")
  milestones  Milestone[]

  @@unique([studyId, type, code])
  @@index([studyId, type, active])
  @@map("catalog_values")
}

model LegalCase {
  id           String       @id @default(uuid()) @db.Uuid
  studyId      String       @map("study_id") @db.Uuid
  clientId     String       @map("client_id") @db.Uuid
  matterId     String       @map("matter_id") @db.Uuid
  stageId      String       @map("stage_id") @db.Uuid
  internalCode String       @map("internal_code")
  title        String
  status       CaseStatus   @default(DRAFT)
  court        String?
  ritRol       String?      @map("rit_rol")
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  study        Study        @relation(fields: [studyId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matter       CatalogValue @relation("CaseMatter", fields: [matterId], references: [id], onDelete: Restrict)
  stage        CatalogValue @relation("CaseStage", fields: [stageId], references: [id], onDelete: Restrict)
  assignments  Assignment[]
  milestones   Milestone[]
  auditEvents  AuditEvent[]

  @@unique([studyId, internalCode])
  @@index([studyId, status, stageId])
  @@index([clientId])
  @@map("legal_cases")
}

model Assignment {
  id            String    @id @default(uuid()) @db.Uuid
  caseId        String    @map("case_id") @db.Uuid
  responsibleId String    @map("responsible_id") @db.Uuid
  assignedById  String    @map("assigned_by_id") @db.Uuid
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(3)
  primary       Boolean   @default(true)
  reason        String?
  legalCase     LegalCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  responsible   User      @relation("AssignmentResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  assignedBy    User      @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([caseId, endedAt])
  @@index([responsibleId, endedAt])
  @@map("assignments")
}

model Milestone {
  id          String       @id @default(uuid()) @db.Uuid
  caseId      String       @map("case_id") @db.Uuid
  typeId      String       @map("type_id") @db.Uuid
  title       String
  occursAt    DateTime     @map("occurs_at") @db.Timestamptz(3)
  timezone    String       @default("America/Santiago")
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  legalCase   LegalCase    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  type        CatalogValue @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([caseId, occursAt])
  @@map("milestones")
}

model AuditEvent {
  id             String     @id @default(uuid()) @db.Uuid
  studyId        String     @map("study_id") @db.Uuid
  caseId         String?    @map("case_id") @db.Uuid
  actorId        String?    @map("actor_id") @db.Uuid
  entityType     String     @map("entity_type")
  entityId       String     @map("entity_id") @db.Uuid
  action         String
  protectedValue Json?      @map("protected_value")
  occurredAt     DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(3)
  study          Study      @relation(fields: [studyId], references: [id], onDelete: Restrict)
  legalCase      LegalCase? @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor          User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([studyId, occurredAt])
  @@index([caseId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}
