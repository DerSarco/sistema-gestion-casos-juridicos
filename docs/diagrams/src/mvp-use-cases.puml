@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction
title Casos de uso del MVP priorizado — 2026-11-09

actor "Socio\nACT-01" as Partner
actor "Abogado\nACT-02" as Lawyer
actor "Asistente\nACT-03" as Assistant
actor "Procurador\nACT-04" as Clerk
actor "Usuario interno autorizado" as User

Partner --|> User
Lawyer --|> User
Assistant --|> User
Clerk --|> User

rectangle "Sistema interno — MVP" {
  usecase "CU-001\nAcceder a la plataforma" as CU001
  usecase "CU-003\nRegistrar, mantener y gestionar\nestado de clientes" as CU003
  usecase "CU-004\nRegistrar, mantener y gestionar\narchivo de casos" as CU004
  usecase "CU-005\nAsignar responsable,\nparticipantes y prioridad" as CU005
  usecase "CU-006\nRegistrar fecha relevante" as CU006
  usecase "CU-007\nConsultar historial básico" as CU007
  usecase "CU-008\nBuscar clientes y casos" as CU008
  usecase "CU-013\nRegistrar antecedentes\nobtenidos manualmente" as CU013
}

User --> CU001
User --> CU003
User --> CU004
User --> CU005
User --> CU006
User --> CU007
User --> CU008
User --> CU013

note bottom of CU001
  RF-001 se implementa
  en el último incremento funcional.
end note
note bottom of CU013
  La OJV no es actor ni interfaz técnica.
  Tribunal y RIT/ROL se registran manualmente.
end note

note left of User
  Las operaciones efectivas dependen
  de la matriz de permisos pendiente.
  Desactivar, reactivar, archivar o restaurar
  exige permiso elevado y auditoría.
end note
@enduml
