@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
hide methods
title Modelo de datos reducido del MVP — 2026-11-09

class Estudio <<ED-01>> {
  id: UUID
  nombre: String
}
class Usuario <<ED-02>> {
  id: UUID
  identificadorAcceso: String
  rol: String
  activo: Boolean
}
class Cliente <<ED-04>> {
  id: UUID
  nombre: String
  email?: String
  telefono?: String
  activo: Boolean
  motivoCambio?: String
}
class Caso <<ED-05>> {
  id: UUID
  codigoInterno: String
  materia: String
  estado: String
  etapa: String
  subetapa?: String
  prioridad: String
  archivado: Boolean
  informacionLaboral?: Json
  tribunal?: String
  ritRol?: String
}
class Participacion <<ED-06>> {
  id: UUID
  rolOperativo: String
  principal: Boolean
  inicio: Instant
  termino?: Instant
}
class FechaRelevante <<ED-08>> {
  id: UUID
  tipo: String
  fecha: Instant
  zona: String
  fuente?: String
  observacion?: String
}
class EventoHistorial <<ED-09>> {
  id: UUID
  accion: String
  fecha: Instant
  detalleProtegido?: Json
}

Estudio "1" *-- "0..*" Usuario
Estudio "1" *-- "0..*" Cliente
Estudio "1" *-- "0..*" Caso
Cliente "1" -- "0..*" Caso
Caso "1" *-- "1..*" Participacion
Participacion "0..*" --> "1" Usuario : responsable o participante
Caso "1" *-- "0..*" FechaRelevante
FechaRelevante "0..*" --> "1" Usuario : responsable
Caso "1" *-- "0..*" EventoHistorial
EventoHistorial "0..*" --> "0..1" Usuario : actor

note right of Caso
  Siete etapas principales; subetapas, estados y
  prioridades usan catálogos pendientes de validación.
  Tribunal y RIT/ROL admiten ausencia.
  El archivo es reversible y conserva relaciones.
end note
note left of Cliente
  La desactivación es reversible.
  No existe eliminación física en el MVP.
end note
note bottom of FechaRelevante
  Registro manual. No calcula plazos
  judiciales definitivos ni crea alertas automáticas.
end note
note bottom of EventoHistorial
  Historial básico aditivo para cambios priorizados.
end note
@enduml
